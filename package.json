{
  "name": "clientapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:cloudflare-pages": "VITE_STATIC_HOST=cloudflare-pages vite build",
    "build:github-pages": "VITE_STATIC_HOST=github-pages VITE_BASE_PATH=/banebooking vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:production:build": "node scripts/build-production-e2e.mjs",
    "test:e2e:production": "npm run test:e2e:production:build && npm run verify:production-builds && playwright test --config playwright.production.config.ts",
    "verify:production-builds": "node scripts/verify-production-builds.mjs",
    "styling:baseline": "node scripts/measure-styling-baseline.mjs --check",
    "styling:baseline:update": "npm run test:e2e:production:build && node scripts/measure-styling-baseline.mjs --write",
    "styling:cascade:check": "node scripts/check-styling-cascade-contract.mjs",
    "styling:guards:fixtures": "node scripts/check-styling-guard-fixtures.mjs",
    "styling:theme:check": "node scripts/check-styling-theme-contract.mjs",
    "typecheck": "npm run typecheck:svelte",
    "typecheck:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "architecture:check": "node scripts/check-architecture-boundaries.mjs",
    "legacy:check": "node scripts/check-legacy-frontend-removal.mjs",
    "design-system:check": "node scripts/check-design-system-boundaries.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run architecture:check && npm run legacy:check && npm run design-system:check && npm run lint && npm run format:check"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@internationalized/date": "^3.12.3",
    "@sentry/browser": "^10.70.0",
    "@supabase/supabase-js": "^2.104.1",
    "@tanstack/svelte-query": "^6.1.38",
    "@tiptap/core": "3.22.4",
    "@tiptap/extension-table": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "bits-ui": "^2.19.0",
    "date-fns": "^4.1.0",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/svelte-query-devtools": "^6.1.40",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^25.2.2",
    "axe-core": "^4.13.0",
    "eslint": "^10.2.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.5.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "postcss-selector-parser": "^7.1.5",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
