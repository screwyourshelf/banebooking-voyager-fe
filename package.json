{
  "name": "clientapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:cloudflare-pages": "VITE_STATIC_HOST=cloudflare-pages vite build",
    "build:github-pages": "VITE_STATIC_HOST=github-pages VITE_BASE_PATH=/banebooking vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "verify:frontend": "npm test && npm run check && npm run test:e2e:visual && npm run test:e2e:production",
    "test:e2e": "playwright test",
    "test:e2e:visual": "playwright test --config playwright.visual.config.ts",
    "test:e2e:headed": "playwright test --headed",
    "performance:baseline": "PERFORMANCE_BASELINE=1 playwright test e2e/performance-baseline.spec.ts",
    "performance:backend-summary": "node scripts/summarize-performance-backend-log.mjs",
    "test:e2e:production:build": "node scripts/build-production-e2e.mjs",
    "test:e2e:production": "npm run test:e2e:production:build && npm run verify:production-builds && playwright test --config playwright.production.config.ts",
    "verify:production-builds": "node scripts/verify-production-builds.mjs",
    "styling:baseline": "node scripts/measure-styling-baseline.mjs --check",
    "styling:baseline:update": "npm run test:e2e:production:build && node scripts/measure-styling-baseline.mjs --write",
    "styling:cascade:check": "node scripts/check-styling-cascade-contract.mjs",
    "styling:guards:fixtures": "node scripts/check-styling-guard-fixtures.mjs",
    "styling:guards:production": "node scripts/check-styling-production-tree.mjs",
    "styling:theme:check": "node scripts/check-styling-theme-contract.mjs",
    "typecheck": "npm run typecheck:svelte",
    "typecheck:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "architecture:check": "node scripts/check-architecture-boundaries.mjs",
    "legacy:check": "node scripts/check-legacy-frontend-removal.mjs",
    "static-analysis:check": "node scripts/check-static-analysis.mjs",
    "design-system:check": "node scripts/check-design-system-boundaries.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run architecture:check && npm run legacy:check && npm run static-analysis:check && npm run design-system:check && npm run styling:theme:check && npm run styling:cascade:check && npm run styling:guards:fixtures && npm run styling:guards:production && npm run styling:baseline && npm run lint && npm run format:check"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@hugeicons/core-free-icons": "4.2.3",
    "@internationalized/date": "^3.12.4",
    "@sentry/browser": "^11.9.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/svelte-query": "^6.3.6",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "bits-ui": "^2.20.2",
    "date-fns": "^4.4.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/svelte-query-devtools": "^6.3.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "knip": "6.43.0",
    "postcss": "^8.5.32",
    "postcss-selector-parser": "^7.1.7",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^24.15.0"
  }
}
